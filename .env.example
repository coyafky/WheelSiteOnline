# Next.js 环境变量模板 —— 复制成 .env.local（已被 .gitignore 忽略）后填写。
#
# ⚠️ 这里只放**变量名**与说明，任何真实密钥都不要写进本文件。

# ── WordPress（内容读取）────────────────────────────────────────────────────
# 例如 http://localhost:8081/wp-json/wp/v2（本地实验场）或 https://cms.example.com/wp-json/wp/v2
WP_API_URL=
# 浏览器可访问的 WordPress 公网地址；构建 Next 图片优化器时必须允许此源。
# 运行容器仍使用 WP_API_URL/WP_REST_ROOT 的 Docker 内部地址读取 CMS。
WP_PUBLIC_API_URL=
# 生产构建默认不注册 localhost/127.0.0.1:8081 的图片来源（避免图片优化器被
# 指向内网地址，构成 SSRF 面）。单机 Docker Compose 且 WordPress 确实监听在
# 回环地址时，才把它设成 true。
ALLOW_LOOPBACK_WP_MEDIA=
# 应用密码，形如 "user:xxxx xxxx xxxx xxxx"（Basic）。仅服务端使用。
WP_API_TOKEN=
# live 才会真的读/写 CMS；其它值一律按 mock 处理（本地默认 mock）。
WP_MODE=mock

# ── 正式站点 URL（构建时固化）──────────────────────────────────────────────
# 唯一 SEO 基址来源。未配置时 robots 会 fail-closed 为全站禁止抓取，sitemap 为空。
# 正式构建必须填写最终 https 域名，并核对产物中的 canonical/robots/sitemap。
NEXT_PUBLIC_APP_URL=

# ── 本地开发预览来源（仅 next dev）──────────────────────────────────────────
# 使用稳定本地域名或开发隧道预览时，填写额外允许访问开发资源的主机名；只写
# hostname，不带协议和端口，多个值用逗号分隔。127.0.0.1 与本机当前 IPv4 地址已由
# next.config.ts 自动允许，不必重复填写。
NEXT_DEV_ALLOWED_ORIGINS=

# ── WordPress（询盘写入，DEC-055）───────────────────────────────────────────
# 询盘端点位于项目命名空间 fh/v1，不在 wp/v2 下。留空则从 WP_API_URL 去掉结尾的
# /wp/v2 推导（即 …/wp-json）。
WP_REST_ROOT=
# 询盘服务密钥 —— 与 WordPress 容器里的 FH_INQUIRY_SERVICE_KEY 必须是同一个值。
#   本地来源：local-wp/.env（模板 local-wp/.env.example）
#   生成：python3 -c "import secrets;print(secrets.token_urlsafe(36))"
# ⚠️ 缺失或 WP_MODE≠live 时，询盘统一返回 503。进程内记录只可用于诊断，绝不构成
#    客户提交成功；只有 WordPress/MySQL 事务完成后才会返回 persisted:true。
WP_INQUIRY_SERVICE_KEY=
# 邮件提供商 delivered/bounced Webhook 的 HMAC 密钥；留空则回调端点关闭。
FH_INQUIRY_WEBHOOK_SECRET=
# 仅供部署清单对照；真正取值配置在 WordPress 运行环境。0 表示禁用。
FH_INQUIRY_RETENTION_DAYS=0
# WordPress 编辑预览与发布 webhook 分别使用独立随机密钥；后者用于 HMAC-SHA256 请求体签名。
WP_PREVIEW_SECRET=
WP_REVALIDATE_SECRET=
# 感谢页短期回执的 HMAC 密钥；生产建议独立设置。留空时回退使用上面的服务密钥。
INQUIRY_RECEIPT_SECRET=

# ── 旧邮件适配器（当前询盘路由不使用）─────────────────────────────────────
# 自 DEC-055 起，销售通知只由 WordPress Outbox 在事务提交后发出。以下变量保留给
# 独立旧适配器测试，不是询盘成功兜底；正式收件人与 QQ SMTP 只在 WordPress 侧配置。
RESEND_API_KEY=
INQUIRY_FROM=inquiry@fenghuai.com
INQUIRY_TO=sales@fenghuai.com

# ── 询盘公开门槛与反滥用 ────────────────────────────────────────────────────
# 已批准且可追溯的隐私政策版本。留空时浏览器不显示可提交表单，API 返回 503。
# 这是公开版本号，不是密钥；修改后需要重新构建前端。
# 本地开发若要演练表单，请在 .env.local 使用明确的本地版本，例如：
# NEXT_PUBLIC_INQUIRY_PRIVACY_VERSION=privacy-local-2026-10-10
NEXT_PUBLIC_INQUIRY_PRIVACY_VERSION=
# 除 NEXT_PUBLIC_APP_URL 外额外允许的 Origin，逗号分隔（通常只用于预发布）。
INQUIRY_ALLOWED_ORIGINS=
