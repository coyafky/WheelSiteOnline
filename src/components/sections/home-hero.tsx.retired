            <span className="block">Custom</span>
            <span className="block text-forge">Forged Wheels</span>
            <span className="mt-2 block font-display text-[clamp(1.35rem,3.6vw,2.6rem)] font-600 uppercase leading-[1.05] tracking-[0.01em] text-white/85">
