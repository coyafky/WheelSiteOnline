# 复制成 local-wp/.env 后使用（local-wp/.env 已被 .gitignore 忽略，不要提交真实密钥）。
#
# 询盘服务密钥：Next.js 服务端 → WordPress 的 POST /fh/v1/inquiries 的专用凭据。
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(36))"
# 同时把同一个值写进仓库根目录的 .env.local（WP_INQUIRY_SERVICE_KEY=...）。
#
# ⚠️ 未配置或为空时，询盘端点在 WordPress 侧 fail-closed 返回 503 —— 不会静默放行。
FH_INQUIRY_SERVICE_KEY=
# 0 = 禁用。正式保留天数必须经隐私/法务批准后填写。
FH_INQUIRY_RETENTION_DAYS=0

# WordPress 内容保存后通知 Next.js 立即刷新目录/详情/文章缓存。
# 本地 Next dev 在宿主机运行时可用：http://host.docker.internal:3000/api/revalidate/wordpress
FH_NEXT_REVALIDATE_URL=
# 与根目录 `.env.local` 的 WP_REVALIDATE_SECRET 使用同一随机值，用于 HMAC-SHA256 请求体签名。
FH_NEXT_REVALIDATE_SECRET=
