local-wp/db-data/
local-wp/wp-data/
local-wp/local-credentials.txt

# local-wp/.env 被 docker compose 自动读取，里面有询盘服务密钥 —— 绝不进 git。
# 该文件的模板是 local-wp/.env.example（这个要提交）。
local-wp/.env

# ⚠️ mu-plugin 的**源**在 local-wp/mu-plugins/（进 git），不在上面被忽略的
#    wp-data/ 里。它是数据库 schema 的唯一所有者（CPT 注册、meta 声明、
#    REST 端点），必须受版本控制，否则 schema 改动不可见、部署时也装不上。
#    改完跑 `python3 scripts/sync-mu-plugins.py` 同步进容器。

# inbox/ 是缓冲区而非永久存储（见 inbox/README.md）。
# 现有 1.6GB 供应商原始库存表（内嵌实拍图）+ 蓝辉轮毂原始表，与上方
# 「供应商原始资料」同类：授权未确认，不进公共仓库。只有 README 记录约定。
inbox/*
!inbox/README.md

# 工具运行时缓存（可再生，与本项目内容无关）
.codegraph/
.playwright-cli/

# ⚠️ PPT 派生材料（不是原始 PPT 目录，是它的提取物）—— 与上方「供应商原始资料」同一条
# 理由：三份 PPT 的逐页全文提取、整页渲染图、从中抽出的原图，实质就是原始资料本身；
# 而其预览图带「试用水印」、素材授权未确认。原目录 `3家公司的PPT资料/` 早在忽略清单里，
# 提取物却漏了 → 2026-10-06 补齐，并从公开仓库历史中清除。
resources/research/2026-10-04-site-plan/
outputs/hangpeng-wheel-media/
