{
  "name": "wheel-site-online",
  "version": "0.1.0",
  "private": true,
  "description": "Fenghuai (Shenzhen) four-product-line B2B/B2C enquiry website — English-first Next.js front end with a Headless WordPress content back end.",
  "author": "coyaFky",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/coyafky/WheelSiteOnline.git"
  },
  "homepage": "https://github.com/coyafky/WheelSiteOnline",
  "bugs": {
    "url": "https://github.com/coyafky/WheelSiteOnline/issues"
  },
  "keywords": [
    "fenghuai",
    "wheels",
    "flow-formed",
    "forged-wheels",
    "ev-components",
    "custom-aluminum",
    "self-sealing-tires",
    "nextjs",
    "headless-wordpress",
    "b2b"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:prod": "npm audit --omit=dev",
    "build": "next build",
    "check": "npm run theme:check && npm run contract:check && npm test && npm run lint && npm run typecheck && npm run build",
    "contract:check": "node scripts/verify-contract-parity.mjs",
    "dev": "next dev",
    "lint": "eslint",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "theme:build": "astryx theme build src/theme/fenghuai-neutral/neutralTheme.ts --out src/theme/fenghuai-neutral/site-theme.css",
    "theme:check": "astryx theme build src/theme/fenghuai-neutral/neutralTheme.ts --out src/theme/fenghuai-neutral/site-theme.css --check",
    "typecheck": "tsc --noEmit",
    "verify:inquiry": "python3 scripts/verify-inquiry-backend.py",
    "verify:inquiry:delivery": "python3 scripts/verify-inquiry-delivery.py"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.7",
    "@astryxdesign/theme-neutral": "^0.6.7",
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "^16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.7",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
